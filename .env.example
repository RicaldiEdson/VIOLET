# ============================================================
# VIOLET - Variables de Entorno (Plantilla de ejemplo)
# ============================================================
# Copie este archivo como ".env" en la raíz del proyecto si su
# entorno o hosting soporta archivos .env o variables de entorno.
# NO suba su archivo .env real con credenciales a GitHub.

# Entorno de la aplicación ('production' o 'development')
VIOLETA_ENV=production

# Ruta base web (déjelo vacío si la web se publica en la raíz de su dominio)
# Ej: BASE_URL= o BASE_URL=/violeta
BASE_URL=

# Conexión individual a MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=violeta_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# O conexión mediante URL unificada (utilizada en Render, Railway, etc.)
# DATABASE_URL=mysql://usuario:password@host:3306/nombre_db
